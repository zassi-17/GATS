<div class = "container-fluid px-0">

  <div class = "card w-100 d-flex justify-content-center align-items-center border-0 bg-dark text-info">
    <%= image_tag "GATS_top.png", class: "card-img-top" %>

    <div class = card-title>
      <h3>Welcome to GATS（Gamers All Track System ）, the Review Site!</h3>
    </div>

    <div class="card-body my-2">
      <h5>新着レビューがあります！<br>
        その他多くのレビューをご覧になりたい方はログインするかアカウント作成してください!</h5>
    </div>
  </div>
</div>

  <div class ="d-flex justify-content-center">
      <%= link_to "まずはゲストログインしてみる（閲覧用）", members_guest_sign_in_path, method: :post, class: "btn btn-lg btn-success px-5 my-3"%>
  </div>

<div class ="container">
    <% @review.each do |review| %>
      <%= render "public/reviews/review_list", review: review %>
    <% end %>


</div>


