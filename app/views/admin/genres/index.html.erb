<div class = "container">

  <!タイトル・バリデーションエラーメッセージ・ジャンル登録メッセージ>
  <div class = "mt-2">
    <h2>ジャンル登録・一覧</h2>

    <% if @genre.errors.any? %>
      <div class = "alert alert-danger">
        <%= @genre.errors.count %>件のエラーが発生しました。
          <ul>
            <% @genre.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
      </div>
    <% end %>
  
    <% if flash[:notice] %>
      <div class = "alert alert-success">
        <%= flash[:notice] %>
      </div>
    <% end %>
  </div>

  <div class = "row d-flex justify-content-between">

    <!ジャンル投稿フォーム>
    <div class = "col-12 col-md-5">
      <div class="field col-10 mt-4">
        <%= form_with model:[:admin,@genre], local: true do |f| %>
          <%= f.label "ジャンル名", class: "col-form-label mb-2" %>
          <%= f.text_field :name, class: "form-control" %>
          <%= f.submit "新規登録", class: "btn btn-primary my-3 px-4" %>
        <% end %>
      </div>
    </div>

    <!ジャンル一覧>
    <div class = "col-12 col-md-7">
      <table class = "table table-hover table-secondary ">
        <thead>
          <tr>
            <th>ジャンル名</th>
            <th></th>
          </tr>
        </thead>

        <% @genres.each do |genre| %>

        <tbody>
          <tr class = "position-relative">
            <td><%= genre.name %></td>
            <td><%= link_to "編集する", edit_admin_genre_path(genre), class: "stretched-link text-dark" %></td>
          </tr>
        </tbody>
      <% end %>
    </table>
  </div>
</div>

