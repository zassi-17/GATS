<div class = "container mt-3">

  <h2>管理者ログイン</h2>
  
  <!ログイン失敗メッセージ>
  <% if flash[:alert] %>
    <div class = "alert alert-danger">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <!ログインフォーム>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    
    <div class = "row d-flex justify-content-center">
      <div class="field col-6 mt-4">
        <%= f.label :メールアドレス, class: "col-form-label"  %><br />
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>

        <%= f.label :パスワード, class: "col-form-label" %><br />
        <%= f.password_field :password, autocomplete: "current-password", class: "form-control" %>
      </div>
    </div>

      <div class="actions text-center mt-5">
        <%= f.submit "ログイン", class: " px-4 mb-2 btn btn-lg btn-success" %>
      </div>
  <% end %>
   
    <!現在、使用しないためコメントアウト>
    <%#= render "admin/shared/links" %>
</div>
