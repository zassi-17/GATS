<div class = "container" >
  
  <!会員数と編集完了しました！メッセージ>
  <div class = "mt-2">
    <h2>全会員数　<%= Member.count %>アカウント</h2>
    
    <% if flash[:notice] %>
      <div class = "alert alert-success">
        <%= flash[:notice] %>
      </div>
    <% end %>
  </div>

  <!管理者用会員一覧の部分テンプレート>
  <%= render 'member_list', members: @members %>
</div>
