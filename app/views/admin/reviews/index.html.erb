<div class = "container">

  <!タイトルとソートリンクとレビュー削除メッセージ>
  <div class = "mt-2">
    <h2>全レビュー　<%= Review.count %>件</h2>
    
    <% if flash[:notice] %>
      <div class = "alert alert-success">
        <%= flash[:notice] %>
      </div>
    <% end %>
  </div>

  <!管理者用レビュー一覧の部分テンプレート>
  <%= render 'review_list', reviews: @reviews %>
</div>

