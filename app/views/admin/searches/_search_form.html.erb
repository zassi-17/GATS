<% if current_admin %>

  <%= form_with url: admin_searches_search_path, local: true, method: :get do |f| %>

    <div class = "d-flex justify-content-end">
      <%= f.text_field :key_word, placeholder: 'こちら管理者用検索フォーム',class: "form-control col-4" %>
      <%= f.select :model, options_for_select([["ユーザー","Member"],["レビュータイトル","Review"]]), { prompt: "--選択してください--" } ,{ class: "form-control col-4 ml-2" } %>
      <%= f.select :search, options_for_select([["完全一致","perfect_match"],["前方一致","forward_match"],
      ["後方一致","backward_match"],["部分一致","partial_match"]]), { prompt: "--選択してください--" } ,{ class: "form-control col-4 ml-2" } %>
    </div>

    <div class = "text-center mr-2 mt-2">
      <%= f.submit "検索", class: "btn header_btn_color px-4" %>
    </div>
  <% end %>
<% end %>