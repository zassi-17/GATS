<div class = "container">
  <!モデル選択フォームでユーザーを選んだ場合の会員一覧>
  <% if @model == "Member" %>
    <h2>ユーザー検索結果：キーワード"<%= @key_word %>"</h2>
      <%= render 'admin/members/member_list', members: @members %>

  <!モデル選択フォームでレビュータイトル選んだ場合のレビュー一覧>
  <% else %>
    <h2>レビュー検索結果：キーワード"<%= @key_word %>"</h2>
      <%= render 'admin/reviews/review_list', reviews: @reviews %>

  <% end %>
</div>
