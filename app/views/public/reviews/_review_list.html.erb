<div class ="card mb-2 p-3 bg-color review_index_color"> 

  <!レビュー一覧の部分テンプレート>
  <div class ="d-flex flex-column flex-md-row">
    
    <div class ="d-flex flex-column align-items-center mr-3">
      <%= review.member.name %>
      <div class ="mt-1"><%= image_tag review.member.image, size: "70x70", class: "rounded-circle" %></div>
    </div>

    <div class ="d-flex flex-column flex-grow-1">
      
      <div class ="d-flex flex-column flex-sm-row justify-content-between align-items-start mb-2">
        <div class ="mr-1">
          <%= render "public/reviews/static_rating", review: review %>

          <div class = "mt-2">
            <%= review.title %>
          </div>

          <div class = "mt-3">
            <%= truncate(review.body, length: 30, omission: "......") %>
          </div>
        </div>

        <div class ="mr-2 mt-3 mt-sm-5">
          
          <div class = "mb-3 mb-sm-2">
            ゲームジャンル：<%= review.genre.name %>
          </div>

          <div>
            コメント数：<%= review.review_comments.count %>
          </div>
        </div>
        
        <div class = "mt-3 mt-sm-5">
          <div class = "mb-3">
            投稿日：<%= review.created_at.strftime("%Y/%m/%d %H:%M") %>
          </div>
          
          <% if current_member %>
            <%= link_to "この投稿を確認する>>>>>", public_review_path(review), class: "btn btn-outline-primary" %>
          <% end %>
        </div>
      </div>
      
    </div>
  </div>
</div>