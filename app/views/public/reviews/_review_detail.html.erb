  <% if @review.is_active %>
    <h2 class = "text-success">公開レビュー</h2>
  <% else %>
    <h2 class = "text-danger">非公開レビュー</h2>
  <% end %>
</div>
  
<div class = "col-12 col-lg-9 mt-1">
  <table>
    <tbody>
      <tr>
        <th>評価：</th>
        <td><%= render "public/reviews/static_rating", review: review %></td>
      </tr>

      <tr>
        <th>ゲームタイトル：</th>
        <td class = "text-break"><%= review.title %></td>
      </tr>

      <tr>
        <th>ゲームジャンル：</th>
        <td class = "text-break"><%= review.genre.name %></td>
      </tr>

      <tr>
        <th>感想：</th>
        <td class = "text-break"><%= review.body %><td>
      </tr>
    </tbody>
  </table>
