<div class = "container">
  <div class = "row mt-2 d-flex justify-content-between align-items-end flex-column flex-md-row">
    <div class = "mb-2 ml-3">
      <%= render "public/searches/genre_search_form", review: @review %>
    </div>

    <div class = "mr-3">
      <%= link_to "新しい順", public_reviews_path(latest: "true") %>
      |<%= link_to "古い順", public_reviews_path(old: "true") %>
      |<%= link_to "評価の高い順", public_reviews_path(rating_count: "true") %>
    </div>
  </div>

  <% @reviews.each do |review| %>
    <%= render 'review_list', review: review %>
  <% end %>


  <div class = "d-flex justify-content-center">
    <%= paginate @reviews %>
  </div>
</div>


