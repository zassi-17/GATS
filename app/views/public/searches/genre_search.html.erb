<!ジャンル検索結果のレビュー一覧>
<div class = "container">
  <h2>ジャンル：
    <% if @genre.nil? %>
      すべてのレビュー
    <% else %>
      ”<%= @genre.name %>”のレビュー
    <% end %>
  </h2>
  
  <% @reviews.each do |review| %>
    <%= render 'public/reviews/review_list', review: review %>
  <% end %>

  <div class = "d-flex justify-content-center">
    <%= paginate @reviews %>
  </div>
</div>