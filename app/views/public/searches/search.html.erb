<div class = "container">
  <% if @model == "Member" %>
    <h2>ユーザー検索結果：キーワード"<%= @key_word %>"</h2>
      <% @members.each do |member| %>
        <div class ="card my-2 p-3 bg-color member_index_color"> 

          <div class ="d-flex flex-column flex-md-row">
    
            <div class ="d-flex flex-column align-items-center mr-3">
              <%= member.name %>
              <%= image_tag member.image, size: "70x70", class: "rounded-circle" %>
            </div>

            <div class ="d-flex flex-column flex-grow-1">
      
              <div class ="d-flex flex-column flex-sm-row justify-content-between align-items-start mb-2">
                <div class ="mr-3">
                  <div class ="mt-2">
                    好きなゲームソフト：<%= member.favorite_game %>
                  </div>

                  <div class = "mt-3">
                    自己紹介：<%= truncate(member.introduction, length: 30, omission: "......") %>
                  </div>
                </div>

                <div>
                  <div class = "mt-2">
                    総レビュー数：<%= member.reviews.count %>
                  </div>
                </div>
        
                <div class ="mt-4">
                  <%= link_to "このユーザーを確認する>>>>>", public_member_path(member) %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>

    <div class = "d-flex justify-content-center">
      <%= paginate @members %>
    </div>

  <% else %>
    <h2>ゲームソフト検索結果：キーワード"<%= @key_word %>"</h2>
      <% @reviews.each do |review| %>
        <%= render 'public/reviews/review_list', review: review %>
      <% end %>

      <div class = "d-flex justify-content-center">
        <%= paginate @reviews %>
      </div>
  <% end %>
</div>
    
