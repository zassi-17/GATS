<div class = "container">
  <h1>マイページ</h1>

  <h2> 
    <%if flash[:alert] %>
      <div class = "alert alert-danger"><%= flash[:alert] %></div>
    <% end %>

    <% if flash[:notice] %>
      <div class = "alert alert-success">
        <%= flash[:notice] %>
      </div>
    <% end %>
  </h2>
  
  <div class = "row mt-3">

  <%= render 'member_detail', member:@member %>
  </div>

  <div class = "my-3 text-center">
    <%= link_to "プロフィール編集", edit_public_member_path(@member), class: "btn btn-success px-3" %>
  </div>

  <% @reviews.each do |review| %>
    <%= render 'public/reviews/review_list', review: review %>
  <% end %>

  <div class = "d-flex justify-content-center"> 
    <%= paginate @reviews %>
  </div>
</div>